/Slogobox {
	/fntscale exch def
	/yi exch def
	/xi exch def

	/xsize {  5.0 fntscale mul .075 3 fntscale mul mul sub } def
	/ysize {  1.4 fntscale mul } def

	gsave
	0 setgray

	xi yi moveto
	xi xsize add yi lineto
	0 ysize rlineto
