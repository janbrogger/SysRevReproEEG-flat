{com}. 
. // ================================================================
. // STEP 13c: Horvitz-Thompson weighted kappa (exact, no gamma)
. //
. // The sample was stratified on epileptiform discharges only.
. // Observer B (Schimsheimer, 13 positives) is the pre-classifier,
. // so B=1 in the 16-cell pattern identifies EPI stratum exactly.
. //
. // Exact sampling weights:
. //   w_epi = (19/157) / (13/50)   [EPI stratum, oversampled]
. //   w_neg = (138/157) / (37/50)  [non-EPI stratum, undersampled]
. //
. // For each pairwise 2×2, weight each EEG by its stratum weight.
. // W_total = w_epi*13 + w_neg*37 is constant across all rows.
. // ================================================================
. 
. use "97-donselaar\vd1992_constrained_thesis.dta", clear
{txt}
{com}. 
. scalar w_epi = (19/157) / (13/50)
{txt}
{com}. scalar w_neg = (138/157) / (37/50)
{txt}
{com}. di as text "w_epi = " as result w_epi
{res}{txt}w_epi = {res}.46545811
{txt}
{com}. di as text "w_neg = " as result w_neg
{res}{txt}w_neg = {res}1.187812
{txt}
{com}. 
. // Sanity: total weighted N should be constant (~50)
. gen W_check = w_epi*13 + w_neg*37
{txt}
{com}. assert abs(W_check - w_epi*13 - w_neg*37) < 1e-10
{txt}
{com}. drop W_check
{txt}
{com}. 
. // ------------------------------------------------------------------
. // Pair A-B  (digits 1,2)
. // (A=1,B=1) and (A=0,B=1) cells all have B=1 → w_epi
. // (A=1,B=0) and (A=0,B=0) cells all have B=0 → w_neg
. // ------------------------------------------------------------------
. gen w_AB_11 = w_epi * (n1100+n1101+n1110+n1111)
{txt}
{com}. gen w_AB_10 = w_neg * (n1000+n1001+n1010+n1011)
{txt}
{com}. gen w_AB_01 = w_epi * (n0100+n0101+n0110+n0111)
{txt}
{com}. gen w_AB_00 = w_neg * (n0000+n0001+n0010+n0011)
{txt}
{com}. gen W_AB    = w_AB_11 + w_AB_10 + w_AB_01 + w_AB_00
{txt}
{com}. gen Po_AB   = (w_AB_11 + w_AB_00) / W_AB
{txt}
{com}. gen pA_AB   = (w_AB_11 + w_AB_10) / W_AB
{txt}
{com}. gen pB_AB   = (w_AB_11 + w_AB_01) / W_AB
{txt}
{com}. gen Pe_AB   = pA_AB*pB_AB + (1-pA_AB)*(1-pB_AB)
{txt}
{com}. gen kw_AB   = (Po_AB - Pe_AB) / (1 - Pe_AB)
{txt}
{com}. 
. // ------------------------------------------------------------------
. // Pair A-C  (digits 1,3)
. // Mixed: each cell has B=0 or B=1 depending on digit 2
. // ------------------------------------------------------------------
. gen w_AC_11 = w_neg*(n1010+n1011) + w_epi*(n1110+n1111)
{txt}
{com}. gen w_AC_10 = w_neg*(n1000+n1001) + w_epi*(n1100+n1101)
{txt}
{com}. gen w_AC_01 = w_neg*(n0010+n0011) + w_epi*(n0110+n0111)
{txt}
{com}. gen w_AC_00 = w_neg*(n0000+n0001) + w_epi*(n0100+n0101)
{txt}
{com}. gen W_AC    = w_AC_11 + w_AC_10 + w_AC_01 + w_AC_00
{txt}
{com}. gen Po_AC   = (w_AC_11 + w_AC_00) / W_AC
{txt}
{com}. gen pA_AC   = (w_AC_11 + w_AC_10) / W_AC
{txt}
{com}. gen pC_AC   = (w_AC_11 + w_AC_01) / W_AC
{txt}
{com}. gen Pe_AC   = pA_AC*pC_AC + (1-pA_AC)*(1-pC_AC)
{txt}
{com}. gen kw_AC   = (Po_AC - Pe_AC) / (1 - Pe_AC)
{txt}
{com}. 
. // ------------------------------------------------------------------
. // Pair A-D  (digits 1,4)
. // ------------------------------------------------------------------
. gen w_AD_11 = w_neg*(n1001+n1011) + w_epi*(n1101+n1111)
{txt}
{com}. gen w_AD_10 = w_neg*(n1000+n1010) + w_epi*(n1100+n1110)
{txt}
{com}. gen w_AD_01 = w_neg*(n0001+n0011) + w_epi*(n0101+n0111)
{txt}
{com}. gen w_AD_00 = w_neg*(n0000+n0010) + w_epi*(n0100+n0110)
{txt}
{com}. gen W_AD    = w_AD_11 + w_AD_10 + w_AD_01 + w_AD_00
{txt}
{com}. gen Po_AD   = (w_AD_11 + w_AD_00) / W_AD
{txt}
{com}. gen pA_AD   = (w_AD_11 + w_AD_10) / W_AD
{txt}
{com}. gen pD_AD   = (w_AD_11 + w_AD_01) / W_AD
{txt}
{com}. gen Pe_AD   = pA_AD*pD_AD + (1-pA_AD)*(1-pD_AD)
{txt}
{com}. gen kw_AD   = (Po_AD - Pe_AD) / (1 - Pe_AD)
{txt}
{com}. 
. // ------------------------------------------------------------------
. // Pair B-C  (digits 2,3)
. // (B=1,*) cells all have B=1 → w_epi; (B=0,*) → w_neg
. // ------------------------------------------------------------------
. gen w_BC_11 = w_epi * (n0110+n0111+n1110+n1111)
{txt}
{com}. gen w_BC_10 = w_epi * (n0100+n0101+n1100+n1101)
{txt}
{com}. gen w_BC_01 = w_neg * (n0010+n0011+n1010+n1011)
{txt}
{com}. gen w_BC_00 = w_neg * (n0000+n0001+n1000+n1001)
{txt}
{com}. gen W_BC    = w_BC_11 + w_BC_10 + w_BC_01 + w_BC_00
{txt}
{com}. gen Po_BC   = (w_BC_11 + w_BC_00) / W_BC
{txt}
{com}. gen pB_BC   = (w_BC_11 + w_BC_10) / W_BC
{txt}
{com}. gen pC_BC   = (w_BC_11 + w_BC_01) / W_BC
{txt}
{com}. gen Pe_BC   = pB_BC*pC_BC + (1-pB_BC)*(1-pC_BC)
{txt}
{com}. gen kw_BC   = (Po_BC - Pe_BC) / (1 - Pe_BC)
{txt}
{com}. 
. // ------------------------------------------------------------------
. // Pair B-D  (digits 2,4)
. // ------------------------------------------------------------------
. gen w_BD_11 = w_epi * (n0101+n0111+n1101+n1111)
{txt}
{com}. gen w_BD_10 = w_epi * (n0100+n0110+n1100+n1110)
{txt}
{com}. gen w_BD_01 = w_neg * (n0001+n0011+n1001+n1011)
{txt}
{com}. gen w_BD_00 = w_neg * (n0000+n0010+n1000+n1010)
{txt}
{com}. gen W_BD    = w_BD_11 + w_BD_10 + w_BD_01 + w_BD_00
{txt}
{com}. gen Po_BD   = (w_BD_11 + w_BD_00) / W_BD
{txt}
{com}. gen pB_BD   = (w_BD_11 + w_BD_10) / W_BD
{txt}
{com}. gen pD_BD   = (w_BD_11 + w_BD_01) / W_BD
{txt}
{com}. gen Pe_BD   = pB_BD*pD_BD + (1-pB_BD)*(1-pD_BD)
{txt}
{com}. gen kw_BD   = (Po_BD - Pe_BD) / (1 - Pe_BD)
{txt}
{com}. 
. // ------------------------------------------------------------------
. // Pair C-D  (digits 3,4)
. // ------------------------------------------------------------------
. gen w_CD_11 = w_neg*(n0011+n1011) + w_epi*(n0111+n1111)
{txt}
{com}. gen w_CD_10 = w_neg*(n0010+n1010) + w_epi*(n0110+n1110)
{txt}
{com}. gen w_CD_01 = w_neg*(n0001+n1001) + w_epi*(n0101+n1101)
{txt}
{com}. gen w_CD_00 = w_neg*(n0000+n1000) + w_epi*(n0100+n1100)
{txt}
{com}. gen W_CD    = w_CD_11 + w_CD_10 + w_CD_01 + w_CD_00
{txt}
{com}. gen Po_CD   = (w_CD_11 + w_CD_00) / W_CD
{txt}
{com}. gen pC_CD   = (w_CD_11 + w_CD_10) / W_CD
{txt}
{com}. gen pD_CD   = (w_CD_11 + w_CD_01) / W_CD
{txt}
{com}. gen Pe_CD   = pC_CD*pD_CD + (1-pC_CD)*(1-pD_CD)
{txt}
{com}. gen kw_CD   = (Po_CD - Pe_CD) / (1 - Pe_CD)
{txt}
{com}. 
. // ------------------------------------------------------------------
. // Group kappa: mean of 6 pairwise weighted kappas (Schouten)
. // ------------------------------------------------------------------
. gen kw_group = (kw_AB + kw_AC + kw_AD + kw_BC + kw_BD + kw_CD) / 6
{txt}
{com}. 
. summarize kw_AB kw_AC kw_AD kw_BC kw_BD kw_CD kw_group, format

{txt}    Variable {c |}        Obs        Mean    Std. dev.       Min        Max
{hline 13}{c +}{hline 57}
{space 7}kw_AB {c |}{res}        184    .5122166    .0610849   .4335708    .559404
{txt}{space 7}kw_AC {c |}{res}        184    .4220666    .0936039   .2107767   .5644524
{txt}{space 7}kw_AD {c |}{res}        184    .3471229    .0958757   .1202274   .5354062
{txt}{space 7}kw_BC {c |}{res}        184    .3472081    .0537785    .233185   .3885173
{txt}{space 7}kw_BD {c |}{res}        184    .3464825    .0650162   .2196521   .4299818
{txt}{hline 13}{c +}{hline 57}
{space 7}kw_CD {c |}{res}        184    .5210258    .0685738     .37953    .637112
{txt}{space 4}kw_group {c |}{res}        184    .4160204     .010769   .3940444   .4376656
{txt}
{com}. 
. // Mean pairwise raw agreement 
. gen Po_group_w = (Po_AB + Po_AC + Po_AD + Po_BC + Po_BD + Po_CD) / 6
{txt}
{com}. gen Pe_group_w = (Pe_AB + Pe_AC + Pe_AD + Pe_BC + Pe_BD + Pe_CD) / 6
{txt}
{com}. summarize Po_group_w Pe_group_w, format

{txt}    Variable {c |}        Obs        Mean    Std. dev.       Min        Max
{hline 13}{c +}{hline 57}
{space 2}Po_group_w {c |}{res}        184    .8032761    .0027444   .7971649   .8092041
{txt}{space 2}Pe_group_w {c |}{res}        184    .6650521    .0050027   .6519261   .6743902
{txt}
{com}. 
. save "97-donselaar\vd1992_weighted_kappa.dta", replace
{txt}{p 0 4 2}
(file {bf}
97-donselaar\vd1992_weighted_kappa.dta{rm}
not found)
{p_end}
{p 0 4 2}
file {bf}
97-donselaar\vd1992_weighted_kappa.dta{rm}
saved
{p_end}

{com}. 
. cap log close
{smcl}
{com}{sf}{ul off}