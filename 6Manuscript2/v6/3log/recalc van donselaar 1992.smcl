{txt}{space 4}kappa_AD {c |}{res}        184    .4169961    .0802518   .2727273   .5454546
{txt}{space 4}kappa_BC {c |}{res}        184    .4780965    .0647617   .3383743   .5274102
{txt}{space 4}kappa_BD {c |}{res}        184    .4998076    .0811126   .3362832   .6017699
