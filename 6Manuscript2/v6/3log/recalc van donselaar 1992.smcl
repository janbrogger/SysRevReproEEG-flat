{smcl}
{com}{sf}{ul off}{txt}{.-}
      name:  {res}<unnamed>
       {txt}log:  {res}C:\Midlertidig_Lagring\SysRevReproEeg\6Manuscript2\v1\3log/recalc van donselaar 1992.smcl
  {txt}log type:  {res}smcl
 {txt}opened on:  {res}15 Apr 2026, 11:21:31
{txt}
{com}. pwd
{res}C:\Midlertidig_Lagring\SysRevReproEeg\6Manuscript2\v1
{txt}
{com}. 
. 
. // ================================================================
. // VAN DONSELAAR 1992 -- Feasible EEG rating distribution enumeration
. // Epileptiform discharges: yes/no, 4 raters, 50 EEGs
. // ================================================================
. //
. // WHY NOT ENUMERATE ALL 16-CELL DISTRIBUTIONS THEN FILTER?
. // The unconstrained count of non-negative integer vectors summing
. // to 50 across 16 cells is C(65,15) ~ 4.5x10^11 rows.
. // At 64 bytes/row that is ~29 terabytes -- not storable, not
. // generatable. Stata's practical .dta ceiling is ~2 GB.
. //
. // SOLUTION: impose the 4 marginal constraints + total DURING
. // generation. This reduces the system to 5 free integer parameters,
. // enumerable via nested loops in Mata. The 6 pairwise "both-yes"
. // cells (a-values) are the intermediate quantities linking the
. // outer (a-value) loop to the inner (free-parameter) loop.
. // ================================================================
. 
. clear all
{res}{txt}
{com}. set more off
{txt}
{com}. 
. // ================================================================
. // STEP 1: Known constants from van Donselaar 1992
. // ================================================================
. 
. // Positive counts per observer (EEGs rated "epileptiform: yes")
. // A=10, B=13 (R.-J.S., had clinical info), C=17, D=20
. local MA = 10
{txt}
{com}. local MB = 13
{txt}
{com}. local MC = 17
{txt}
{com}. local MD = 20
{txt}
{com}. local N  = 50
{txt}
{com}. 
. local MA_neg = 40
{txt}
{com}. local MB_neg = 37
{txt}
{com}. local MC_neg = 33
{txt}
{com}. local MD_neg = 30
{txt}
{com}. 
. // Reported pairwise kappa range across all 6 observer pairs
. local kappa_lo = 0.27
{txt}
{com}. local kappa_hi = 0.62
{txt}
{com}. 
. di as text "Known constants:"
{res}{txt}Known constants:

{com}. di as text "  n(EEGs)=" as result `N' as text ///
>    "  A+=" as result `MA' as text ///
>    "  B+=" as result `MB' as text ///
>    "  C+=" as result `MC' as text ///
>    "  D+=" as result `MD'
{res}{txt}  n(EEGs)={res}50{txt}  A+={res}10{txt}  B+={res}13{txt}  C+={res}17{txt}  D+={res}20
{txt}
{com}. di as text "  Pairwise kappa range: [" as result `kappa_lo' ///
>    as text ", " as result `kappa_hi' as text "]"
{res}{txt}  Pairwise kappa range: [{res}.27{txt}, {res}.62{txt}]

{com}. 
. // ================================================================
. // STEP 2: Pairwise chance agreement Pe -- FIXED by marginals
. // Pe_ij = (ni_pos*nj_pos + ni_neg*nj_neg) / N^2
. // These are constants; they do not vary across distributions
. // ================================================================
. 
. local Pe_AB = (`MA'*`MB'  + `MA_neg'*`MB_neg') / (`N'^2)
{txt}
{com}. local Pe_AC = (`MA'*`MC'  + `MA_neg'*`MC_neg') / (`N'^2)
{txt}
{com}. local Pe_AD = (`MA'*`MD'  + `MA_neg'*`MD_neg') / (`N'^2)
{txt}
{com}. local Pe_BC = (`MB'*`MC'  + `MB_neg'*`MC_neg') / (`N'^2)
{txt}
{com}. local Pe_BD = (`MB'*`MD'  + `MB_neg'*`MD_neg') / (`N'^2)
{txt}
{com}. local Pe_CD = (`MC'*`MD'  + `MC_neg'*`MD_neg') / (`N'^2)
{txt}
{com}. 
. di as text _newline "Pairwise Pe (fixed by marginals -- these never change):"
{res}
{txt}Pairwise Pe (fixed by marginals -- these never change):

{com}. foreach pair in AB AC AD BC BD CD {c -(}
{txt}  2{com}.     di as text "  Pe_`pair' = " as result %6.4f `Pe_`pair''
{txt}  3{com}. {c )-}
{txt}  Pe_AB = {res}0.6440
{txt}  Pe_AC = {res}0.5960
{txt}  Pe_AD = {res}0.5600
{txt}  Pe_BC = {res}0.5768
{txt}  Pe_BD = {res}0.5480
{txt}  Pe_CD = {res}0.5320
{txt}
{com}. 
. // ================================================================
. // STEP 3: Feasible integer range of each pairwise both-yes cell
. //
. // For pair (i,j) with marginals ni+, nj+, n=50:
. //   d  = N - ni+ - nj+ + a        (both-no cell)
. //   Po = (a + d) / N              (observed agreement)
. //   kappa = (Po - Pe) / (1-Pe)
. //
. // Solving for a given kappa:
. //   a = [ N*(kappa*(1-Pe) + Pe) - (N - ni+ - nj+) ] / 2
. //
. // a_min = ceil(a at kappa=kappa_lo), bounded below by max(0, ni++nj+-N)
. // a_max = floor(a at kappa=kappa_hi), bounded above by min(ni+,nj+)
. //
. // NOTE: pair marginals defined BEFORE the loop to avoid brace-
. // counting conflict with Stata's foreach parser. Never use inline
. // {c -(} {c )-} on if statements inside a foreach block.
. // ================================================================
. 
. local ni_AB = `MA'
{txt}
{com}. local nj_AB = `MB'
{txt}
{com}. local ni_AC = `MA'
{txt}
{com}. local nj_AC = `MC'
{txt}
{com}. local ni_AD = `MA'
{txt}
{com}. local nj_AD = `MD'
{txt}
{com}. local ni_BC = `MB'
{txt}
{com}. local nj_BC = `MC'
{txt}
{com}. local ni_BD = `MB'
{txt}
{com}. local nj_BD = `MD'
{txt}
{com}. local ni_CD = `MC'
{txt}
{com}. local nj_CD = `MD'
{txt}
{com}. 
. foreach pair in AB AC AD BC BD CD {c -(}
{txt}  2{com}.     local ni = `ni_`pair''
{txt}  3{com}.     local nj = `nj_`pair''
{txt}  4{com}. 
.     local base = `N' - `ni' - `nj'
{txt}  5{com}.     local cap  = min(`ni', `nj')
{txt}  6{com}. 
.     local a_`pair'_min = max(0, ceil( ///
>         (`N'*(`kappa_lo'*(1-`Pe_`pair'')+`Pe_`pair'') - `base') / 2))
{txt}  7{com}.     local a_`pair'_max = min(`cap', floor( ///
>         (`N'*(`kappa_hi'*(1-`Pe_`pair'')+`Pe_`pair'') - `base') / 2))
{txt}  8{com}. {c )-}
{txt}
{com}. 
. di as text _newline "Feasible range of both-yes cell (a) per pair:"
{res}
{txt}Feasible range of both-yes cell (a) per pair:

{com}. foreach pair in AB AC AD BC BD CD {c -(}
{txt}  2{com}.     di as text "  a_`pair' in [" as result `a_`pair'_min' ///
>        as text ", " as result `a_`pair'_max' as text "]"
{txt}  3{com}. {c )-}
{txt}  a_AB in [{res}6{txt}, {res}8{txt}]
  a_AC in [{res}7{txt}, {res}9{txt}]
  a_AD in [{res}7{txt}, {res}10{txt}]
  a_BC in [{res}8{txt}, {res}10{txt}]
  a_BD in [{res}9{txt}, {res}12{txt}]
  a_CD in [{res}10{txt}, {res}14{txt}]

{com}. 
. local n_outer = 1
{txt}
{com}. foreach pair in AB AC AD BC BD CD {c -(}
{txt}  2{com}.     local n_outer = `n_outer' * (`a_`pair'_max' - `a_`pair'_min' + 1)
{txt}  3{com}. {c )-}
{txt}
{com}. di as text _newline "Max outer-loop (a-value) combinations: " as result `n_outer'
{res}
{txt}Max outer-loop (a-value) combinations: {res}2160
{txt}
{com}. 
. // ================================================================
. // STEP 4: Enumerate valid 16-cell distributions (Mata)
. //
. // CELL DECOMPOSITION
. // ------------------
. // Digit order in cell names: A B C D (1=yes, 0=no)
. //
. // k=4 (all yes):  n1111  <- free parameter q
. // k=3 (3 yes):    n1110 n1101 n1011 n0111  <- free: tABC tABD tACD tBCD
. // k=2 (2 yes):    n1100 n1010 n1001 n0110 n0101 n0011  <- derived
. // k=1 (1 yes):    n1000 n0100 n0010 n0001  <- derived from marginals
. // k=0 (all no):   n0000  <- derived from total=50
. //
. // DERIVATION OF 2-WAY CELLS FROM a-VALUES AND FREE PARAMETERS:
. //   pAB = ab_a - tABC - tABD - q
. //   pAC = ac_a - tABC - tACD - q
. //   pAD = ad_a - tABD - tACD - q
. //   pBC = bc_a - tABC - tBCD - q
. //   pBD = bd_a - tABD - tBCD - q
. //   pCD = cd_a - tACD - tBCD - q
. //
. // DERIVATION OF 1-WAY CELLS FROM MARGINALS:
. //   n1000 = MA - pAB - pAC - pAD - tABC - tABD - tACD - q
. //   n0100 = MB - pAB - pBC - pBD - tABC - tABD - tBCD - q
. //   n0010 = MC - pAC - pBC - pCD - tABC - tACD - tBCD - q
. //   n0001 = MD - pAD - pBD - pCD - tABD - tACD - tBCD - q
. //
. // DERIVATION OF n0000 FROM total=50:
. //   n0000 = -10 + (pAB+pAC+pAD+pBC+pBD+pCD)
. //               + 2*(tABC+tABD+tACD+tBCD) + 3*q
. //   (where -10 = N - MA - MB - MC - MD = 50 - 60)
. // ================================================================
. 
. mata:
{txt}{hline 49} mata (type {cmd:end} to exit) {hline}
{com}: void enumerate_vd1992(
>     real scalar MA, real scalar MB, real scalar MC, real scalar MD,
>     real scalar N,
>     real scalar ab_lo, real scalar ab_hi,
>     real scalar ac_lo, real scalar ac_hi,
>     real scalar ad_lo, real scalar ad_hi,
>     real scalar bc_lo, real scalar bc_hi,
>     real scalar bd_lo, real scalar bd_hi,
>     real scalar cd_lo, real scalar cd_hi)
> {c -(}
>     real scalar ab_a, ac_a, ad_a, bc_a, bd_a, cd_a
>     real scalar q, q_max
>     real scalar tABC, tABC_max
>     real scalar tABD, tABD_max
>     real scalar tACD, tACD_max
>     real scalar tBCD, tBCD_max
>     real scalar pAB, pAC, pAD, pBC, pBD, pCD
>     real scalar n1000, n0100, n0010, n0001, n0000
>     real scalar nrow, chunk
>     real matrix buf
> 
>     chunk = 500000
>     buf   = J(chunk, 16, .)
>     nrow  = 0
> 
>     // --- Outer loop: 6 pairwise both-yes cells ---
>     for (ab_a=ab_lo; ab_a<=ab_hi; ab_a++) {c -(}
>     for (ac_a=ac_lo; ac_a<=ac_hi; ac_a++) {c -(}
>     for (ad_a=ad_lo; ad_a<=ad_hi; ad_a++) {c -(}
>     for (bc_a=bc_lo; bc_a<=bc_hi; bc_a++) {c -(}
>     for (bd_a=bd_lo; bd_a<=bd_hi; bd_a++) {c -(}
>     for (cd_a=cd_lo; cd_a<=cd_hi; cd_a++) {c -(}
> 
>     // --- Inner loop: 5 free parameters ---
>     // q = n1111: bounded by all 6 a-values
>     q_max = min((ab_a, ac_a, ad_a, bc_a, bd_a, cd_a))
>     for (q=0; q<=q_max; q++) {c -(}
> 
>     // tABC = n1110: consumes from pairs AB, AC, BC
>     tABC_max = min((ab_a-q, ac_a-q, bc_a-q))
>     for (tABC=0; tABC<=tABC_max; tABC++) {c -(}
> 
>     // tABD = n1101: consumes from pairs AB, AD, BD
>     tABD_max = min((ab_a-q-tABC, ad_a-q, bd_a-q))
>     for (tABD=0; tABD<=tABD_max; tABD++) {c -(}
> 
>     // tACD = n1011: consumes from pairs AC, AD, CD
>     tACD_max = min((ac_a-q-tABC, ad_a-q-tABD, cd_a-q))
>     for (tACD=0; tACD<=tACD_max; tACD++) {c -(}
> 
>     // tBCD = n0111: consumes from pairs BC, BD, CD
>     tBCD_max = min((bc_a-q-tABC, bd_a-q-tABD, cd_a-q-tACD))
>     for (tBCD=0; tBCD<=tBCD_max; tBCD++) {c -(}
> 
>         // Derive 2-way cells
>         pAB = ab_a - tABC - tABD - q
>         pAC = ac_a - tABC - tACD - q
>         pAD = ad_a - tABD - tACD - q
>         pBC = bc_a - tABC - tBCD - q
>         pBD = bd_a - tABD - tBCD - q
>         pCD = cd_a - tACD - tBCD - q
> 
>         // pAD, pBD, pCD not guaranteed >= 0 by loop bounds -- check
>         if (pAD<0 | pBD<0 | pCD<0) continue
> 
>         // Derive 1-way cells from marginals
>         n1000 = MA - pAB - pAC - pAD - tABC - tABD - tACD - q
>         n0100 = MB - pAB - pBC - pBD - tABC - tABD - tBCD - q
>         n0010 = MC - pAC - pBC - pCD - tABC - tACD - tBCD - q
>         n0001 = MD - pAD - pBD - pCD - tABD - tACD - tBCD - q
> 
>         if (n1000<0 | n0100<0 | n0010<0 | n0001<0) continue
> 
>         // Derive n0000 from total=50
>         n0000 = -10 + pAB+pAC+pAD+pBC+pBD+pCD ///
>                     + 2*(tABC+tABD+tACD+tBCD) + 3*q
> 
>         if (n0000 < 0) continue
> 
>         // Valid -- store in pattern order 0000..1111
>         // Column order: n0000 n0001 n0010 n0011(=pCD)
>         //               n0100 n0101(=pBD) n0110(=pBC) n0111(=tBCD)
>         //               n1000 n1001(=pAD) n1010(=pAC) n1011(=tACD)
>         //               n1100(=pAB) n1101(=tABD) n1110(=tABC) n1111(=q)
>         nrow++
>         if (nrow > rows(buf)) buf = buf \ J(chunk, 16, .)
> 
>         buf[nrow,.] = (n0000, n0001, n0010, pCD,
>                        n0100, pBD,   pBC,   tBCD,
>                        n1000, pAD,   pAC,   tACD,
>                        pAB,   tABD,  tABC,  q)
> 
>     {c )-}{c )-}{c )-}{c )-}{c )-} // end inner loops (5: tBCD tACD tABD tABC q)
>     {c )-}{c )-}{c )-}{c )-}{c )-}{c )-} // end outer loops (6: cd_a bd_a bc_a ad_a ac_a ab_a)
> 
>     buf = buf[1..nrow, .]
>     st_matrix("__res__", buf)
>     st_numscalar("__nrow__", nrow)
>     printf("\nEnumeration complete: %g valid distributions found.\n", nrow)
> {c )-}
{txt}note: argument {bf:N} unused.

{com}: end
{txt}{hline}

{com}. 
. // ================================================================
. // STEP 5: Run the enumeration
. // ================================================================
. 
. di as text _newline "Running Mata enumeration..."
{res}
{txt}Running Mata enumeration...

{com}. mata: enumerate_vd1992(`MA',`MB',`MC',`MD',`N', ///
>     `a_AB_min',`a_AB_max', `a_AC_min',`a_AC_max', ///
>     `a_AD_min',`a_AD_max', `a_BC_min',`a_BC_max', ///
>     `a_BD_min',`a_BD_max', `a_CD_min',`a_CD_max')
{res}
Enumeration complete: 51176 valid distributions found.
{txt}
{com}. 
. // ================================================================
. // STEP 6: Load into Stata and name cell variables
. //
. // NOTE: svmat without names(col) creates variables named
. // __res__1 .. __res__16, not col1..col16.
. // ================================================================
. 
. clear
{txt}
{com}. svmat __res__
{txt}number of observations will be reset to 51176
Press any key to continue, or Break to abort
{p}
Number of observations ({bf:_N}) was 0,
now 51,176.
{p_end}

{com}. 
. rename __res__1  n0000
{res}{txt}
{com}. rename __res__2  n0001
{res}{txt}
{com}. rename __res__3  n0010
{res}{txt}
{com}. rename __res__4  n0011
{res}{txt}
{com}. rename __res__5  n0100
{res}{txt}
{com}. rename __res__6  n0101
{res}{txt}
{com}. rename __res__7  n0110
{res}{txt}
{com}. rename __res__8  n0111
{res}{txt}
{com}. rename __res__9  n1000
{res}{txt}
{com}. rename __res__10 n1001
{res}{txt}
{com}. rename __res__11 n1010
{res}{txt}
{com}. rename __res__12 n1011
{res}{txt}
{com}. rename __res__13 n1100
{res}{txt}
{com}. rename __res__14 n1101
{res}{txt}
{com}. rename __res__15 n1110
{res}{txt}
{com}. rename __res__16 n1111
{res}{txt}
{com}. 
. di as text "Dataset: " as result _N as text " rows x 16 cell variables."
{res}{txt}Dataset: {res}51176{txt} rows x 16 cell variables.

{com}. 
. // ================================================================
. // STEP 7: Verify observer marginals (guaranteed by construction)
. // ================================================================
. 
. gen obs_A_positive = n1000+n1001+n1010+n1011+n1100+n1101+n1110+n1111
{txt}
{com}. gen obs_B_positive = n0100+n0101+n0110+n0111+n1100+n1101+n1110+n1111
{txt}
{com}. gen obs_C_positive = n0010+n0011+n0110+n0111+n1010+n1011+n1110+n1111
{txt}
{com}. gen obs_D_positive = n0001+n0011+n0101+n0111+n1001+n1011+n1101+n1111
{txt}
{com}. 
. gen obs_A_negative = n0000+n0001+n0010+n0011+n0100+n0101+n0110+n0111
{txt}
{com}. gen obs_B_negative = n0000+n0001+n0010+n0011+n1000+n1001+n1010+n1011
{txt}
{com}. gen obs_C_negative = n0000+n0001+n0100+n0101+n1000+n1001+n1100+n1101
{txt}
{com}. gen obs_D_negative = n0000+n0010+n0100+n0110+n1000+n1010+n1100+n1110
{txt}
{com}. 
. gen check_total = n0000+n0001+n0010+n0011+n0100+n0101+n0110+n0111 ///
>                 + n1000+n1001+n1010+n1011+n1100+n1101+n1110+n1111
{txt}
{com}. 
. assert obs_A_positive == `MA'
{txt}
{com}. assert obs_B_positive == `MB'
{txt}
{com}. assert obs_C_positive == `MC'
{txt}
{com}. assert obs_D_positive == `MD'
{txt}
{com}. assert check_total    == `N'
{txt}
{com}. di as text _newline "Marginal assertions passed: A=10, B=13, C=17, D=20, total=50."
{res}
{txt}Marginal assertions passed: A=10, B=13, C=17, D=20, total=50.

{com}. 
. // ================================================================
. // STEP 8: Perfect agreement
. // ================================================================
. 
. gen perf_agree = n0000 + n1111
{txt}
{com}. label var perf_agree "EEGs where all 4 raters agreed (both n0000 and n1111)"
{txt}
{com}. 
. // ================================================================
. // STEP 9: Pairwise 2x2 cells (all 6 observer pairs)
. // Convention: XY_a=both yes  XY_b=X yes Y no
. //             XY_c=X no Y yes  XY_d=both no
. // ================================================================
. 
. gen ab_a = n1100+n1101+n1110+n1111
{txt}
{com}. gen ab_b = n1000+n1001+n1010+n1011
{txt}
{com}. gen ab_c = n0100+n0101+n0110+n0111
{txt}
{com}. gen ab_d = n0000+n0001+n0010+n0011
{txt}
{com}. 
. gen ac_a = n1010+n1011+n1110+n1111
{txt}
{com}. gen ac_b = n1000+n1001+n1100+n1101
{txt}
{com}. gen ac_c = n0010+n0011+n0110+n0111
{txt}
{com}. gen ac_d = n0000+n0001+n0100+n0101
{txt}
{com}. 
. gen ad_a = n1001+n1011+n1101+n1111
{txt}
{com}. gen ad_b = n1000+n1010+n1100+n1110
{txt}
{com}. gen ad_c = n0001+n0011+n0101+n0111
{txt}
{com}. gen ad_d = n0000+n0010+n0100+n0110
{txt}
{com}. 
. gen bc_a = n0110+n0111+n1110+n1111
{txt}
{com}. gen bc_b = n0100+n0101+n1100+n1101
{txt}
{com}. gen bc_c = n0010+n0011+n1010+n1011
{txt}
{com}. gen bc_d = n0000+n0001+n1000+n1001
{txt}
{com}. 
. gen bd_a = n0101+n0111+n1101+n1111
{txt}
{com}. gen bd_b = n0100+n0110+n1100+n1110
{txt}
{com}. gen bd_c = n0001+n0011+n1001+n1011
{txt}
{com}. gen bd_d = n0000+n0010+n1000+n1010
{txt}
{com}. 
. gen cd_a = n0011+n0111+n1011+n1111
{txt}
{com}. gen cd_b = n0010+n0110+n1010+n1110
{txt}
{com}. gen cd_c = n0001+n0101+n1001+n1101
{txt}
{com}. gen cd_d = n0000+n0100+n1000+n1100
{txt}
{com}. 
. // ================================================================
. // STEP 10: Pairwise Cohen's kappa
. // Pe is a constant per pair (computed in Step 2)
. // Po varies -- it is the only quantity that changes across rows
. // kappa = (Po - Pe) / (1 - Pe)
. // ================================================================
. 
. gen kappa_AB = ((ab_a+ab_d)/50 - `Pe_AB') / (1 - `Pe_AB')
{txt}
{com}. gen kappa_AC = ((ac_a+ac_d)/50 - `Pe_AC') / (1 - `Pe_AC')
{txt}
{com}. gen kappa_AD = ((ad_a+ad_d)/50 - `Pe_AD') / (1 - `Pe_AD')
{txt}
{com}. gen kappa_BC = ((bc_a+bc_d)/50 - `Pe_BC') / (1 - `Pe_BC')
{txt}
{com}. gen kappa_BD = ((bd_a+bd_d)/50 - `Pe_BD') / (1 - `Pe_BD')
{txt}
{com}. gen kappa_CD = ((cd_a+cd_d)/50 - `Pe_CD') / (1 - `Pe_CD')
{txt}
{com}. 
. // ================================================================
. // STEP 11: Fleiss multi-rater kappa
. //
. // r=4 raters, n=50, binary outcome.
. //
. // p_yes_bar = total yes ratings / (N*r) = 60/200 = 0.30
. //   CONSTANT by construction (marginals are fixed).
. //
. // Pe_fleiss = p_yes_bar^2 + p_no_bar^2 = 0.09 + 0.49 = 0.58
. //   CONSTANT.
. //
. // Po_fleiss: contribution per EEG depends on k (# yes among 4):
. //   general term = [k*(k-1) + (r-k)*(r-k-1)] / [r*(r-1)]
. //   k=0: [0+12]/12 = 1.000
. //   k=1: [0+ 6]/12 = 0.500
. //   k=2: [2+ 2]/12 = 0.333
. //   k=3: [6+ 0]/12 = 0.500
. //   k=4: [12+0]/12 = 1.000
. //
. // Po_fleiss = (12*n_k0 + 6*n_k1 + 4*n_k2 + 6*n_k3 + 12*n_k4) / 600
. // ================================================================
. 
. gen n_k0 = n0000
{txt}
{com}. gen n_k1 = n1000+n0100+n0010+n0001
{txt}
{com}. gen n_k2 = n1100+n1010+n1001+n0110+n0101+n0011
{txt}
{com}. gen n_k3 = n1110+n1101+n1011+n0111
{txt}
{com}. gen n_k4 = n1111
{txt}
{com}. 
. assert n_k0+n_k1+n_k2+n_k3+n_k4 == 50
{txt}
{com}. 
. gen Pe_fleiss   = 0.58
{txt}
{com}. gen Po_fleiss   = (12*n_k0 + 6*n_k1 + 4*n_k2 + 6*n_k3 + 12*n_k4) / 600
{txt}
{com}. gen kappa_fleiss = (Po_fleiss - Pe_fleiss) / (1 - Pe_fleiss)
{txt}
{com}. 
. // Mean of 6 pairwise kappas (alternative interpretation of
. // reported kappa -- paper cites both Cohen 1960 and Schouten 1982)
. gen kappa_mean_pairwise = (kappa_AB+kappa_AC+kappa_AD ///
>                           +kappa_BC+kappa_BD+kappa_CD) / 6
{txt}
{com}. 
