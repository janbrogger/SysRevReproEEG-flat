. // ================================================================
. // STEP 12c: Diagnose Po_fleiss_numerator step structure
. //
. // Po_numerator = 12*n_k0 + 6*n_k1 + 4*n_k2 + 6*n_k3 + 12*n_k4
. // Substituting n_k2 = 50 - n_k0 - n_k1 - n_k3 - n_k4:
. //   = 200 + 8*(n_k0+n_k4) + 2*(n_k1+n_k3)
. //   = 200 + 8*perf_agree + 2*Q
. // where Q = n_k1 + n_k3
. //
. // Numerator is ALWAYS EVEN.
. // Steps are multiples of gcd(8,2)=2 BUT only specific (P,Q)
. // combinations are jointly feasible given pairwise kappa
. // constraints -- gaps may exist near 474.
. // ================================================================
. 
. gen Q_k13 = n_k1 + n_k3
{txt}
{com}. assert Po_fleiss_numerator == 200 + 8*perf_agree + 2*Q_k13
{txt}
{com}. 
. di as text _newline "=== NUMERATOR FREQUENCY NEAR 474 ==="
{res}
