. 
. // ================================================================
. // STEP 13b: Apply constraints from van Donselaar thesis table
. //
. // Van Donselaar provided Table 4.1 from his PhD thesis, giving
. // the exact distribution of EEGs by number of observers agreeing
. // on epileptiform discharges (EPI row):
. //
. //   All 4 yes  (n1111)                     = 6
. //   All 4 no   (n0000)                     = 25
. //   Exactly 3 yes, 1 no (n_k3)             = 5
. //   Exactly 1 yes, 3 no (n_k1)             = 7
. //   Exactly 2 yes, 2 no (n_k2) = 50-6-25-5-7 = 7
. //
. // These are exact counts, not derived. They constrain the
. // feasible set dramatically.
. // ================================================================
. 
. use "97-donselaar\vd1992_consistent_meanpairwise.dta", clear
{txt}
{com}. di as text _newline "Rows before thesis table constraints: " as result _N
{res}
{txt}Rows before thesis table constraints: {res}1345
{txt}
{com}. 
. keep if n1111 == 6
{txt}(867 observations deleted)

{com}. keep if n0000 == 25
{txt}(294 observations deleted)

{com}. keep if n_k3  == 5
{txt}(0 observations deleted)

{com}. keep if n_k1  == 7
{txt}(0 observations deleted)

{com}. keep if n_k2  == 7
{txt}(0 observations deleted)

{com}. 
. di as text "Rows after thesis table constraints: " as result _N
{res}{txt}Rows after thesis table constraints: {res}184
{txt}
{com}. 
