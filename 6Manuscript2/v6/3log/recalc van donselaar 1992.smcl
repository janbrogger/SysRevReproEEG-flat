. // ================================================================
. // STEP 12b: Filter to distributions consistent with reported
. // Fleiss kappa = 0.50 (rounded to 2 d.p.)
. //
. // WHY NOT USE kappa_fleiss DIRECTLY?
. // Floating point arithmetic means kappa_fleiss is never exactly
. // 0.500000 even when the true value is exact. Work instead with
. // the INTEGER numerator of Po_fleiss, which is computed purely
. // from integer cell counts and is always exact.
. //
. // Po_fleiss = numerator / 600
. // kappa = (Po - 0.58) / 0.42
. // kappa rounds to 0.50 when numerator in {c -(}473, 474, 475{c )-}:
. //   473/600 = 0.78833 -> kappa = 0.4960
. //   474/600 = 0.79000 -> kappa = 0.5000 (exact)
. //   475/600 = 0.79167 -> kappa = 0.5040
. // ================================================================
. 
. gen Po_fleiss_numerator = 12*n_k0 + 6*n_k1 + 4*n_k2 + 6*n_k3 + 12*n_k4
{txt}
{com}. assert Po_fleiss_numerator == round(Po_fleiss * 600)
{txt}
{com}. 
. di as text _newline "=== Po NUMERATOR RANGE ==="
{res}
{txt}=== Po NUMERATOR RANGE ===

