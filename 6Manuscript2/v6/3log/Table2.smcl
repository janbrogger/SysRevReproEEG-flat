. * PART B: Study-level summary statistics
. * (First collapse to one median per REFID within each stratum,
. *  then compute median across studies)
. *==============================================================================
. 
. di _n(3) "============================================================"
{res}


============================================================
{txt}
{com}. di "PART B: STUDY-LEVEL MEDIANS"
{res}PART B: STUDY-LEVEL MEDIANS
{txt}
{com}. di "(First median per REFID, then median across studies)"
{res}(First median per REFID, then median across studies)
{txt}
{com}. di "============================================================"
{res}============================================================
{txt}
{com}. 
. * Save working dataset
. global working "2data/temp_table2_working.dta"
{txt}
{com}. save "$working", replace
{txt}{p 0 4 2}
file {bf}
2data/temp_table2_working.dta{rm}
saved
{p_end}

{com}. 
. * --- Helper program to compute study-level stats ---
. * Collapses to one median per REFID, then reports median, min, max, count
. * across studies for a given stratum
. 
. cap program drop study_level_stats
{txt}
{com}. program define study_level_stats
{txt}  1{com}.         syntax , BY(string) [Title(string)]
{txt}  2{com}. 
.         di _n "=== `title' ==="
{txt}  3{com}.         di "Stratified by: `by'"
{txt}  4{com}. 
.         use "$working", clear
{txt}  5{com}. 
.         * Collapse to one median per REFID within each stratum
.         collapse (median) med_agreement = agreementvalue ///
>                 (count) n_datapoints = agreementvalue, ///
>                 by(REFID `by')
{txt}  6{com}. 
.         * Now summarize across studies within each stratum combination
.         di _n "Study-level statistics (each study counts once):"
{txt}  7{com}.         table (`by'), ///
>                 nototal ///
>                 stat(median med_agreement) ///
>                 stat(min med_agreement) ///
>                 stat(max med_agreement) ///
>                 stat(count med_agreement)
{txt}  8{com}. 
.         * Also show as bysort for log readability
.         di _n "Detail by stratum:"
{txt}  9{com}.         bysort `by': summ med_agreement, det
{txt} 10{com}. end
{txt}
{com}. 
. * --- Table B1: Agreement type × Short Clips × Intra/Inter ---
. study_level_stats, by(gAgreementType3 ShortClips2 intra2) ///
>         title("Table B1: Study-level - Statistic × Study design × Rating type")

