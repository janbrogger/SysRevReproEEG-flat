. *==============================================================================
. * Create derived variables for stratification
. *==============================================================================
. 
. * --- Rater experience (matching seizure paper approach) ---
. * Collapse to Experienced (Expert + Experienced + Probably experienced)
. * vs Inexperienced (Nonexpert + Inexperienced)
. gen raterExp3 = ""
{txt}(169 missing values generated)

{com}. replace raterExp3 = "Experienced" if inlist(RaterExpOurAssessed, "Experienced", "Expert", "Probably experienced")
{txt}variable {bf}{res}raterExp3{sf}{txt} was {bf}{res}str1{sf}{txt} now {bf}{res}str11{sf}
{txt}(13 real changes made)

{com}. replace raterExp3 = "Inexperienced" if inlist(RaterExpOurAssessed, "Nonexpert", "Inexperienced")
{txt}(0 real changes made)

{com}. di _n "=== Rater experience ==="
{res}
=== Rater experience ===
{txt}
{com}. tab raterExp3, mis

  {txt}raterExp3 {c |}      Freq.     Percent        Cum.
{hline 12}{c +}{hline 35}
            {c |}{res}        156       92.31       92.31
{txt}Experienced {c |}{res}         13        7.69      100.00
{txt}{hline 12}{c +}{hline 35}
      Total {c |}{res}        169      100.00
{txt}
{com}. 
. * --- Encode string variables for table command ---
. encode intra_or_inter, gen(intra2)
{txt}
{com}. label variable intra2 "Rating type"
{txt}
{com}. 
. encode ShortClips, gen(ShortClips2)
{txt}
{com}. label variable ShortClips2 "Short clips"
{txt}
{com}. 
. encode gEEGSetting, gen(gEEGSetting2)
{txt}
{com}. label variable gEEGSetting2 "Clinical setting"
{txt}
{com}. 
. encode raterExp3, gen(raterExp4)
{txt}
{com}. label variable raterExp4 "Rater experience"
{txt}
{com}. 
. encode agreementType3, gen(gAgreementType3)
{txt}
{com}. label variable gAgreementType3 "Statistic"
{txt}
{com}. 
