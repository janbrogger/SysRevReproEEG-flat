. use "$working", clear
{txt}
{com}. 
. * Loop over the 4 main cells
. foreach atype in "Agreement" "Kappa-type" {c -(}
{txt}  2{com}.         foreach rtype in "Yes" "No" {c -(}
{txt}  3{com}.                 if "`rtype'" == "Yes" local rlabel "Intrarater"
{txt}  4{com}.                 if "`rtype'" == "No"  local rlabel "Interrater"
{txt}  5{com}. 
.                 di _n "--- `atype' / `rlabel' ---"
{txt}  6{com}. 
.                 * Data-point level
.                 qui summ agreementvalue if agreementType3 == "`atype'" & intra_or_inter == "`rtype'", det
{txt}  7{com}.                 local dp_median = `r(p50)'
{txt}  8{com}.                 local dp_min = `r(min)'
{txt}  9{com}.                 local dp_max = `r(max)'
{txt} 10{com}.                 local dp_n = `r(N)'
{txt} 11{com}.                 di "  Data-point level: median = " %5.2f `dp_median' ///
>                         "  range = " %5.2f `dp_min' " - " %5.2f `dp_max' ///
>                         "  N datapoints = " `dp_n'
{txt} 12{com}. 
.                 * Study level
.                 preserve
{txt} 13{com}.                 keep if agreementType3 == "`atype'" & intra_or_inter == "`rtype'"
{txt} 14{com}.                 collapse (median) med_agreement = agreementvalue ///
>                         (count) n_dp = agreementvalue, by(REFID)
{txt} 15{com}.                 qui summ med_agreement, det
{txt} 16{com}.                 local sl_median = `r(p50)'
{txt} 17{com}.                 local sl_min = `r(min)'
{txt} 18{com}.                 local sl_max = `r(max)'
{txt} 19{com}.                 local sl_n = `r(N)'
{txt} 20{com}.                 di "  Study level:      median = " %5.2f `sl_median' ///
>                         "  range = " %5.2f `sl_min' " - " %5.2f `sl_max' ///
>                         "  N studies = " `sl_n'
{txt} 21{com}. 
.                 local diff = `dp_median' - `sl_median'
{txt} 22{com}.                 di "  Difference (dp - study): " %5.2f `diff'
{txt} 23{com}. 
.                 * Show data points per study
.                 di "  Data points per study:"
{txt} 24{com}.                 list REFID n_dp, sep(0) noobs
{txt} 25{com}.                 restore
{txt} 26{com}.         {c )-}
{txt} 27{com}. {c )-}

