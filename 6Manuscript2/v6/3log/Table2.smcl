. *==============================================================================
. * Load filtered data (same as Figure 1)
. *==============================================================================
. 
. cap confirm file "2data/filtered_data.dta"
{txt}
{com}. use "2data/filtered_data.dta", clear
{txt}
{com}. count
  {res}169
{txt}
{com}. local totalobs = `r(N)'
{txt}
{com}. di "Total observations loaded: `totalobs'"
{res}Total observations loaded: 169
{txt}
{com}. 
. *==============================================================================
. * Create EEG Setting variable (same as Figure 1)
. *==============================================================================
. 
. cap drop gEEGSetting
{txt}
{com}. gen gEEGSetting = ""
{txt}(169 missing values generated)

{com}. replace gEEGSetting = "Epilepsy" if Q019TypeofEEGsettingbroad == "Epilepsy"
{txt}variable {bf}{res}gEEGSetting{sf}{txt} was {bf}{res}str1{sf}{txt} now {bf}{res}str8{sf}
{txt}(136 real changes made)

{com}. replace gEEGSetting = "Acute Brain" if Q019TypeofEEGsettingbroad == "Coma/critical care, not neonatal or status epilepticus"
{txt}variable {bf}{res}gEEGSetting{sf}{txt} was {bf}{res}str8{sf}{txt} now {bf}{res}str11{sf}
{txt}(15 real changes made)

{com}. replace gEEGSetting = "Other" if gEEGSetting == ""
{txt}(18 real changes made)

