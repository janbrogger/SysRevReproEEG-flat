Combined forest plot saved to 4output/Fig1_ForestPlots_IED.png
{txt}
{com}. 
. *==============================================================================
. * Calculate and display summary statistics (mean and 95% CI)
. *==============================================================================
. 
. di _n "===== Summary Statistics ====="
{res}
===== Summary Statistics =====
{txt}
{com}. 
. * Reload data for clean calculations
. use "2data/filtered_data.dta", clear
{txt}
{com}. keep if agreementType3 == "Agreement" | agreementType3 == "Kappa-type"
{txt}(0 observations deleted)

{com}. 
. * Function to calculate mean and CI
. capture program drop DisplayMeanCI
{txt}
{com}. program define DisplayMeanCI
{txt}  1{com}.     syntax [if], label(string)
{txt}  2{com}. 
.     preserve
{txt}  3{com}.     if `"`if'"' != `""' {c -(}
{txt}  4{com}.         qui keep `if'
{txt}  5{com}.     {c )-}
{txt}  6{com}. 
.     qui summ agreementvalue
{txt}  7{com}.     local n = `r(N)'
{txt}  8{com}.     local mean = `r(mean)'
{txt}  9{com}.     local sd = `r(sd)'
{txt} 10{com}.     local se = `sd' / sqrt(`n')
{txt} 11{com}. 
.     * 95% CI using t-distribution
.     local t = invttail(`n' - 1, 0.025)
{txt} 12{com}.     local ci_lower = `mean' - `t' * `se'
{txt} 13{com}.     local ci_upper = `mean' + `t' * `se'
{txt} 14{com}. 
.     di "`label': Mean = " %5.3f `mean' " (95% CI: " %5.3f `ci_lower' " - " %5.3f `ci_upper' "), n = " `n'
{txt} 15{com}. 
.     restore
{txt} 16{com}. end
{txt}
{com}. 
. DisplayMeanCI if agreementType3 == "Agreement" & intra_or_inter == "Yes", label("Intrarater Agreement")
Intrarater Agreement: Mean = 0.856 (95% CI: 0.822 - 0.890), n = 6
{txt}
{com}. DisplayMeanCI if agreementType3 == "Agreement" & intra_or_inter == "No", label("Interrater Agreement")
Interrater Agreement: Mean = 0.619 (95% CI: 0.508 - 0.730), n = 26
{txt}
{com}. DisplayMeanCI if agreementType3 == "Kappa-type" & intra_or_inter == "Yes", label("Intrarater Kappa")
Intrarater Kappa: Mean = 0.685 (95% CI: 0.605 - 0.764), n = 17
{txt}
{com}. DisplayMeanCI if agreementType3 == "Kappa-type" & intra_or_inter == "No", label("Interrater Kappa")
Interrater Kappa: Mean = 0.571 (95% CI: 0.525 - 0.618), n = 113
{txt}
{com}. 
. *==============================================================================
. * Clean up
. *==============================================================================
. 
. cap graph drop agree_intra agree_inter kappa_intra kappa_inter
{txt}
{com}. 
. cap log close
{smcl}
{com}{sf}{ul off}