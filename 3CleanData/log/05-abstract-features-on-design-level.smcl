{com}. 
. title "Extract feature count and a feature string for each study"


{res}*******************************************************************************
*******************************************************************************
*****                                                                     *****
*****                                                                     *****
*****     Extract feature count and a feature string for each study       *****
*****                                                                     *****
*****                                                                     *****
*****                                            17 Mar 2026    13:43:47  *****
*******************************************************************************
*******************************************************************************


{txt}
{com}. use "C:\Midlertidig_Lagring\sysrevreproeeg\3CleanData\data-cleaned\2featuredata-cleaned" , clear
{txt}
{com}. contract REFID featurescored
{res}{txt}
{com}. drop _freq
{txt}
{com}. sort REFID
{txt}
{com}. by REFID: gen featurecount=_N
{txt}
{com}. sort REFID, stable
{txt}
{com}. by REFID : gen allfeaturenames = featurescored[1]
{txt}(1 missing value generated)

{com}. by REFID : replace allfeaturenames= allfeaturenames[_n-1] + ";" + featurescored  if _n > 1
{txt}(625 real changes made)

{com}. by REFID : replace allfeaturenames = allfeaturenames[_N]
{txt}(625 real changes made)

{com}. count
  {res}921
{txt}
{com}. contract REFID featurecount allfeaturenames
{res}{txt}
{com}. count
  {res}296
{txt}
{com}. drop _freq
{txt}
{com}. 
. label variable featurecount "Count of features studied"
{txt}
{com}. label variable allfeaturenames "All EEG features studied, separated by semicolon."
{txt}
{com}. 
. tempfile featurenames
{txt}
{com}. save "`featurenames'"
{txt}{p 0 4 2}
