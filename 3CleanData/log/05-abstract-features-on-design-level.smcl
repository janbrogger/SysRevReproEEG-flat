. title "Extract agreement types for each reference from feature-level data"


{res}*******************************************************************************
*******************************************************************************
*****                                                                     *****
*****                                                                     *****
***** Extract agreement types for each reference from feature-level data  *****
*****                                                                     *****
*****                                                                     *****
*****                                            17 Mar 2026    13:43:47  *****
*******************************************************************************
*******************************************************************************


{txt}
{com}. use "C:\Midlertidig_Lagring\sysrevreproeeg\3CleanData\data-cleaned\2featuredata-cleaned" , clear
{txt}
{com}. levelsof agreementType2
{res}{txt}`"Brennan and Prediger kappa"' `"Cohen's kappa"' `"Cohen's quadratically weighted kappa"' `"Cronbach's alpha"' `"Fleiss' kappa"' `"Fleiss' kappa, aggregate"' `"Free-Marginal Multirater Kappa (kFree)"' `"Gwet's AC1"' `"Gwet's AC2"' `"ICC"' `"Kappa 5 pairs median"' `"Krippendorff's alpha"' `"Mean kappa"' `"Mean or median Kappa 2 raters across neonates"' `"Median 3-rater kappa"' `"Median Cohen's kappa"' `"Median agreement"' `"Median majority kappa"' `"Median majority perfect agreement"' `"Median pairwise kappa"' `"Median pairwise perfect agreement"' `"Percent agreement 5 pairs median"' `"Spearman–Brown prophecy reliability coefficient"' `"Unadjusted agreement"' `"Unadjusted agreement, aggregate"' `"Unweighted kappa"' `"Weighted kappa - quadratic weights"' `"Weighted kappa - unknown weights"' `"Weighted kappa - unspecified weights"' `"Weighted kappa, unknown average method"' `"Weighted unadjusted agreement"' `"mean Cohen's kappa"'

{com}. local i=0
{txt}
{com}. foreach t in `r(levels)' {c -(}
{txt}  2{com}.         local i=`i'+1   
{txt}  3{com}.         gen hasAgreementType2_`i'=agreementType2=="`t'"
{txt}  4{com}.         label variable hasAgreementType2_`i' "`t'"      
{txt}  5{com}. {c )-}
{txt}
{com}. 
. contract REFID hasAgreementType2_*
{res}{txt}
{com}. drop _freq
{txt}
{com}. sort REFID
{txt}
{com}. foreach v of varlist hasAgreementType2_* {c -(}
{txt}  2{com}.         egen x`v'=max(`v') , by(REFID)
{txt}  3{com}.         local lab : variable label `v'
{txt}  4{com}.         label variable x`v' "`lab'"
{txt}  5{com}. {c )-}
{txt}
{com}. contract REFID xhasAgreementType2_*
{res}{txt}
{com}. foreach v of varlist xhasAgreementType2_* {c -(}
{txt}  2{com}.         local newv = substr("`v'",2,.)
{txt}  3{com}.         rename `v' `newv'
{txt}  4{com}. {c )-}
{res}{txt}
{com}. count
