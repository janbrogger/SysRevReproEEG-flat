*******************************************************************************


{txt}
{com}. use "C:\Midlertidig_Lagring\sysrevreproeeg\3CleanData\data-cleaned\2featuredata-cleaned" , clear
{txt}
{com}. levelsof agreementType3
{res}{txt}`"Agreement"' `"Kappa-type"' `"Kappa-type, aggregate"' `"Unadjusted agreement, aggregate"'

{com}. local i=0
{txt}
{com}. foreach t in `r(levels)' {c -(}
{txt}  2{com}.         local i=`i'+1   
{txt}  3{com}.         gen hasAgreementType3_`i'=agreementType3=="`t'"
{txt}  4{com}.         label variable hasAgreementType3_`i' "`t'"      
{txt}  5{com}. {c )-}
{txt}
{com}. 
. contract REFID hasAgreementType3_*
{res}{txt}
{com}. drop _freq
{txt}
{com}. sort REFID
{txt}
{com}. foreach v of varlist hasAgreementType3_* {c -(}
{txt}  2{com}.         egen x`v'=max(`v') , by(REFID)
{txt}  3{com}.         local lab : variable label `v'
{txt}  4{com}.         label variable x`v' "`lab'"
{txt}  5{com}. {c )-}
{txt}
{com}. contract REFID xhasAgreementType3_*
{res}{txt}
{com}. foreach v of varlist xhasAgreementType3_* {c -(}
{txt}  2{com}.         local newv = substr("`v'",2,.)
{txt}  3{com}.         rename `v' `newv'
{txt}  4{com}. {c )-}
{res}{txt}
